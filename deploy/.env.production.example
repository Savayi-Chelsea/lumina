# Template for deploy/.env on the server. The real file is created on the
# server (chmod 600) and is never committed. Replace every CHANGE_ME.

# Public address served by Caddy (HTTPS certificate is obtained automatically),
# e.g. 13-60-1-2.sslip.io for Elastic IP 13.60.1.2.
SITE_ADDRESS=CHANGE_ME
AUTH_URL=https://CHANGE_ME
APP_ORIGIN=https://CHANGE_ME
AUTH_TRUST_HOST=true

# Database (only reachable on the server's loopback interface)
POSTGRES_USER=lumina
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lumina
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Auth.js. Generate with: openssl rand -base64 33
AUTH_SECRET=CHANGE_ME
# Optional: Google sign-in (add https://<SITE_ADDRESS>/api/auth/callback/google
# as an authorised redirect URI in Google Cloud Console). Leave blank to hide.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Matching service
MATCHING_SERVICE_URL=http://127.0.0.1:8000
MATCHING_SERVICE_TIMEOUT_MS=60000
MATCHING_TOP_K=5
MATCHING_SIMILARITY_THRESHOLD=0.5
MATCHING_RANKING=semantic

# Email: captured by Mailpit on the server (view via SSM port-forward to 8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Lumina <no-reply@lumina.local>"

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Job feed (optional)
JSEARCH_API_KEY=
