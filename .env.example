POSTGRES_USER=lumina
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumina
POSTGRES_PORT=5432
MATCHING_TOP_K=5
MATCHING_SIMILARITY_THRESHOLD=0.5

# Google authentication (server-only; never prefix these with NEXT_PUBLIC_)
# Generate AUTH_SECRET locally with: npx auth secret
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret
# Must match the origin registered in Google Cloud Console
AUTH_URL=http://localhost:3000
# Optional: DATABASE_URL=postgresql://user:password@localhost:5432/lumina
# Otherwise the Next.js app reuses the POSTGRES_* variables above.
