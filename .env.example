POSTGRES_USER=lumina
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumina
POSTGRES_PORT=5432
MATCHING_TOP_K=5
MATCHING_SIMILARITY_THRESHOLD=0.5
# Next.js -> matching API, server-only (never NEXT_PUBLIC_)
MATCHING_SERVICE_URL=http://127.0.0.1:8000
# Bounded request timeout; prewarm /ready before a demonstration.
MATCHING_SERVICE_TIMEOUT_MS=60000

# Authentication (server-only; never prefix these with NEXT_PUBLIC_)
# AUTH_SECRET alone enables email/password sessions; Google also needs the two AUTH_GOOGLE_* values.
# Generate AUTH_SECRET locally with: npx auth secret
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret
# Must match the origin registered in Google Cloud Console
AUTH_URL=http://localhost:3000
# Authoritative public origin for mentorship CSRF checks; server-only.
APP_ORIGIN=http://localhost:3000
# Optional: DATABASE_URL=postgresql://user:password@localhost:5432/lumina
# Otherwise the Next.js app reuses the POSTGRES_* variables above.

# Email (password reset). Local default: Mailpit from docker compose; open http://localhost:8025 to read mail.
# In production, point these at a real SMTP provider and set SMTP_SECURE/SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Lumina <no-reply@lumina.local>"
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=

# Profile-change events (docker compose service "kafka"); used by scripts/run_profile_events.py
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
